# Public URL of this deployment. Google push notifications need https.
APP_URL=https://calendar-cascade.vercel.app

# Dashboard sign-in. SESSION_SECRET signs the session cookie: openssl rand -base64 32
ADMIN_PASSWORD=
SESSION_SECRET=

# Encrypts Google refresh tokens at rest. Must decode to 32 bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (type: Web application).
# Authorized redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase project. Server only; never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends this as a bearer token on cron invocations.
CRON_SECRET=
